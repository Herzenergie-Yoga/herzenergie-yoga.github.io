---
interface Props {
    images: string[];
    imgPosition: string;
    height: string;
}

const { images, imgPosition, height } = Astro.props;

// Ab md liegen alle Bilder nebeneinander im Streifen – dort gibt es nichts zu blättern.
const hasControls = images.length > 1;
---

<div
    class:list={["w-full relative bg-brand-bg", height]}
    data-header-carousel
    role={hasControls ? "region" : undefined}
    aria-label={hasControls ? "Bildergalerie" : undefined}
>
    <div
        class="flex h-full overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:snap-none md:overflow-hidden"
        data-carousel-track
    >
        {
            images.map((src, index) => (
                <img
                    src={src}
                    alt="Herzenergie Yoga"
                    class:list={[
                        "header-img w-full h-full object-cover shrink-0 snap-start md:w-auto md:flex-1",
                        imgPosition,
                    ]}
                    data-slide-index={index}
                />
            ))
        }
    </div>

    {
        hasControls && (
            <>
                <button
                    type="button"
                    class="glass-control absolute left-3 top-1/2 -translate-y-1/2 md:hidden z-10"
                    aria-label="Vorheriges Bild"
                    data-carousel-prev
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m14.5 5-6 7 6 7" />
                    </svg>
                </button>

                <button
                    type="button"
                    class="glass-control absolute right-3 top-1/2 -translate-y-1/2 md:hidden z-10"
                    aria-label="Nächstes Bild"
                    data-carousel-next
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <path d="m9.5 5 6 7-6 7" />
                    </svg>
                </button>

                <!-- Indicator dots for mobile/tablet -->
                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 md:hidden z-10" data-carousel-dots>
                    {images.map((_, i) => (
                        <button
                            type="button"
                            class="carousel-dot w-2 h-2 rounded-full bg-white/50 transition-all duration-300 aria-current:w-5 aria-current:bg-white"
                            aria-label={`Zu Bild ${i + 1}`}
                            aria-current={i === 0 ? "true" : "false"}
                            data-dot-index={i}
                        />
                    ))}
                </div>
            </>
        )
    }
</div>

<style>
    /* Liquid Glass: durchscheinende Linse mit Lichtkante und Glanzlicht oben links */
    .glass-control {
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        color: #fff;
        background:
            radial-gradient(
                125% 90% at 30% 8%,
                rgb(255 255 255 / 0.5),
                rgb(255 255 255 / 0) 60%
            ),
            rgb(255 255 255 / 0.22);
        backdrop-filter: blur(14px) saturate(180%);
        border: 1px solid rgb(255 255 255 / 0.45);
        box-shadow:
            0 6px 20px rgb(0 0 0 / 0.2),
            inset 0 1px 1px rgb(255 255 255 / 0.6),
            inset 0 -8px 14px rgb(255 255 255 / 0.1);
        transition:
            transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
            background-color 220ms ease,
            opacity 220ms ease;
    }

    @supports (-webkit-backdrop-filter: blur(1px)) {
        .glass-control {
            -webkit-backdrop-filter: blur(14px) saturate(180%);
        }
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
        .glass-control {
            background: rgb(120 120 120 / 0.6);
        }
    }

    .glass-control svg {
        width: 1.25rem;
        height: 1.25rem;
        filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.4));
    }

    .glass-control:hover {
        background:
            radial-gradient(
                125% 90% at 30% 8%,
                rgb(255 255 255 / 0.65),
                rgb(255 255 255 / 0) 60%
            ),
            rgb(255 255 255 / 0.32);
        transform: scale(1.06);
    }

    .glass-control:active {
        transform: scale(0.92);
    }

    .glass-control:focus-visible {
        outline: 2px solid rgb(255 255 255 / 0.9);
        outline-offset: 2px;
    }

    .carousel-dot {
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.3);
    }

    @media (prefers-reduced-motion: reduce) {
        .glass-control {
            transition: none;
        }

        .glass-control:hover,
        .glass-control:active {
            transform: none;
        }
    }
</style>

<script>
    let carouselAbort: AbortController | null = null;

    function initHeaderCarousels() {
        carouselAbort?.abort();
        carouselAbort = new AbortController();
        const { signal } = carouselAbort;

        document
            .querySelectorAll<HTMLElement>("[data-header-carousel]")
            .forEach((root) => {
                const track = root.querySelector<HTMLElement>("[data-carousel-track]");
                const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
                const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
                const dots = root.querySelectorAll<HTMLButtonElement>("[data-dot-index]");
                if (!track) return;

                const step = (direction: number) => {
                    const prefersReducedMotion = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;
                    const maxScroll = track.scrollWidth - track.clientWidth;

                    // Continuous looping navigation
                    if (direction > 0 && track.scrollLeft >= maxScroll - 10) {
                        track.scrollTo({
                            left: 0,
                            behavior: prefersReducedMotion ? "auto" : "smooth",
                        });
                    } else if (direction < 0 && track.scrollLeft <= 10) {
                        track.scrollTo({
                            left: maxScroll,
                            behavior: prefersReducedMotion ? "auto" : "smooth",
                        });
                    } else {
                        track.scrollBy({
                            left: direction * track.clientWidth,
                            behavior: prefersReducedMotion ? "auto" : "smooth",
                        });
                    }
                };

                const updateActiveDot = () => {
                    if (dots.length === 0) return;
                    const currentIndex = Math.round(track.scrollLeft / track.clientWidth);
                    dots.forEach((dot, index) => {
                        dot.setAttribute("aria-current", index === currentIndex ? "true" : "false");
                    });
                };

                prev?.addEventListener("click", () => step(-1), { signal });
                next?.addEventListener("click", () => step(1), { signal });

                dots.forEach((dot) => {
                    const idx = Number(dot.dataset.dotIndex ?? 0);
                    dot.addEventListener("click", () => {
                        const prefersReducedMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        track.scrollTo({
                            left: idx * track.clientWidth,
                            behavior: prefersReducedMotion ? "auto" : "smooth",
                        });
                    }, { signal });
                });

                track.addEventListener("scroll", updateActiveDot, {
                    passive: true,
                    signal,
                });
                window.addEventListener("resize", updateActiveDot, { signal });

                updateActiveDot();
            });
    }

    document.addEventListener("astro:page-load", initHeaderCarousels);
</script>
