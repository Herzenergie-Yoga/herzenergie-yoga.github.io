---
import Layout from "../layouts/Layout.astro";
import { toHref } from "../utils/paths";
---

<Layout title="Specials – Rauhnächte">
    <h1>Rauhnächte</h1>

    <p class="not-prose text-center text-brand-primary font-antic-didone tracking-[0.15em] uppercase text-sm mb-10">
        13 Wünsche · Kakao-Ritual · Yin Yoga
    </p>

    <h2>Termine</h2>

    <div class="not-prose my-10 border border-brand-secondary/20 px-6 py-8 sm:px-10 sm:py-10 space-y-8 text-center">
        <div class="space-y-3">
            <p class="text-brand-primary font-antic-didone text-xl">Sonntag, 20. Dezember 2026</p>
            <p class="text-brand-text font-light tracking-wide">16–18 Uhr</p>
            <p class="inline-block border border-brand-secondary/40 px-4 py-2 text-brand-primary font-semibold">Bereits ausgebucht</p>
        </div>

        <div class="border-t border-brand-secondary/20 pt-8 space-y-3">
            <p class="text-brand-primary font-antic-didone text-xl">Samstag, 19. Dezember 2026</p>
            <p class="text-brand-primary font-semibold">Zusätzlicher Termin in Planung</p>
            <p class="text-brand-text font-light text-sm">Weitere Informationen folgen.</p>
        </div>
    </div>

    <h2>Ort</h2>

    <p class="text-center">Physiopraxis Lina Eichler · Kloster Oesede</p>

    <h2>Energieausgleich</h2>

    <p class="text-center">35 € inklusive Kakao und Schreibmaterial</p>

    <h2>Interesse am zusätzlichen Termin?</h2>

    <p>
        Bei Interesse am geplanten Termin am 19. Dezember melde dich gerne bei Ninja Seidel:
        <strong><a href="tel:+491632876265">0163 2876265</a></strong>.
    </p>

    <img
        src={toHref("/img/rauhnaechte-2026.jpeg")}
        alt="Rauhnächte: 13 Wünsche, Kakao-Ritual und Yin Yoga am Sonntag, 20. Dezember, 16–18 Uhr, in der Physiopraxis Lina Eichler in Kloster Oesede. 35 € inklusive Kakao und Schreibmaterial. Dieser Termin ist bereits ausgebucht."
        width="900"
        height="1600"
        loading="lazy"
    />
</Layout>
