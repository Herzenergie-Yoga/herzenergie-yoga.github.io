---
import Layout from '../../layouts/Layout.astro';
import { toHref } from '../../utils/paths';

const yogastile = [
  {
    href: '/kurse/hatha-yoga',
    name: 'Hatha Yoga',
    tagline: 'Kraftvoll & sanft im Gleichgewicht',
    info: ['Neue Kurse wieder im Frühjahr 2027'],
  },
  {
    href: '/kurse/yin-yoga',
    name: 'Yin Yoga & ätherische Öle',
    tagline: 'Still werden, tief loslassen',
    info: ['Monatliche einzelne Termine', '14.11. · Kloster Oesede', '18.11. · Sutthausen'],
  },
  {
    href: '/kurse/kinder-yoga',
    name: 'Kinder-Yoga',
    tagline: 'Spielen, atmen, wachsen – Yoga für kleine Menschen.',
    info: ['Neue Kurse in Planung'],
  },
];
---

<Layout title="Kurse">
  <h1>Kurse</h1>

  <p>Schön, dass du hier bist. Hier findest du einen Überblick über meine Yogakurse – jeder mit seinem eigenen Charakter, jeder mit ganz viel Raum für dich.</p>
  <p>Wähle einfach den Stil, der dich gerade ruft, und erfahre mehr.</p>

  <div class="not-prose my-12 grid grid-cols-1 sm:grid-cols-2 gap-8">
    {yogastile.map((stil, i) => (
      <a
        href={toHref(stil.href)}
        class:list={[
          'group border border-brand-secondary/20 px-6 py-10 text-center flex flex-col space-y-5 hover:bg-white transition-colors',
          i === yogastile.length - 1 && yogastile.length % 2 === 1 && 'sm:col-span-2 sm:mx-auto sm:w-[calc(50%-1rem)]',
        ]}
      >
        <h3 class="text-5xl font-alex-brush text-brand-primary font-normal min-h-24 flex items-center justify-center">{stil.name}</h3>
        <p class="text-brand-text font-light tracking-wide text-sm leading-relaxed italic min-h-12 flex items-center justify-center">{stil.tagline}</p>
        <div class="space-y-2">
          {stil.info.map((info) => (
            <p class="text-sm tracking-wide text-brand-text/80 font-light">{info}</p>
          ))}
        </div>
        <div class="mt-auto pt-5 border-t border-brand-secondary/20">
          <span class="text-brand-primary font-antic-didone tracking-[0.15em] text-sm uppercase group-hover:underline underline-offset-4">Mehr erfahren</span>
        </div>
      </a>
    ))}
  </div>
</Layout>
